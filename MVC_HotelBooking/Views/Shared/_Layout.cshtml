<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MVC_HotelBooking</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVC_HotelBooking.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">MVC_HotelBooking</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav ms-auto">

                        @if (ViewBag.User == null)
                        {
                            <!-- CHƯA LOGIN -->
                            <li class="nav-item">
                                <a class="nav-link" href="/Account/Login">Login</a>
                            </li>
                        }
                        else
                        {
                            var user = ViewBag.User;

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-success" data-bs-toggle="dropdown">
                                    👤 @user.Email
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end">

                                    <!-- USER -->
                                    @if (user.Role == "Customer")
                                    {
                                        <li>
                                            <a class="dropdown-item" href="/Booking">Lịch sử booking</a>
                                        </li>
                                    }
              

                                    <!-- ADMIN ONLY -->
                                    @if (user.Role == "Admin")
                                    {
                                        <li>
                                            <a class="dropdown-item text-primary" href="/Admin/Dashboard">
                                                Admin Dashboard
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item" href="/Admin/Rooms">
                                                Quản lý phòng
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item" href="/Admin/Bookings">
                                                Quản lý Booking
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="/Admin/User">
                                                Quản lý User
                                            </a>
                                        </li>
                                    }

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a class="dropdown-item text-danger" href="/Account/Logout">
                                            Logout
                                        </a>
                                    </li>

                                </ul>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MVC_HotelBooking - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
