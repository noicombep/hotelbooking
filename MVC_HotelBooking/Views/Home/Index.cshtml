@using BusinessObject
@model List<RoomDTO>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <h2 class="text-center mb-4">🏨 Danh sách phòng</h2>

    <div class="row">
        @foreach (var room in Model)
        {
            var image = room.Images?.FirstOrDefault()
            ?? "https://via.placeholder.com/300x200";

            <div class="col-md-4 mb-4">
                <div class="card shadow h-100 border-0">

                    <!-- IMAGE -->
                    <img src="@("https://localhost:7123" + (@image ?? "/images/no-image.png"))" class="card-img-top"
                         style="height:200px; object-fit:cover;" />

                    <div class="card-body">
                        <h5 class="card-title fw-bold">
                            🛏️ Phòng @room.RoomNumber
                        </h5>

                        <p class="text-muted mb-1">
                            Loại: <b>@room.Type</b>
                        </p>

                        <p class="text-muted mb-2">
                            Sức chứa: <b>@room.Capacity người</b>
                        </p>

                        <p class="card-text">
                            @room.Description
                        </p>

                        <h5 class="text-danger fw-bold">
                            @room.Price.ToString("N0") đ / đêm
                        </h5>
                    </div>

                    <div class="card-footer text-center bg-white border-0">
                        <a href="/Room/Detail/@room.Id"
                           class="btn btn-primary w-100">
                            Xem chi tiết
                        </a>
                    </div>

                </div>
            </div>
        }
    </div>
</div>